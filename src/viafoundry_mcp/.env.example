# ViaFoundry MCP Server Configuration
# Copy this file to .env and fill in your credentials

# ViaFoundry hostname (e.g., https://your-viafoundry-instance.com)
VIAFOUNDRY_HOSTNAME=https://your-viafoundry-host.com

# ViaFoundry username
VIAFOUNDRY_USERNAME=your-username

# ViaFoundry password
VIAFOUNDRY_PASSWORD=your-password
